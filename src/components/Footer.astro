---
import type { Props } from "@astrojs/starlight/props";

import EditLink from "@astrojs/starlight/components/EditLink.astro";

import Pagination from "@astrojs/starlight/components/Pagination.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import { LinkCard, CardGrid } from "@astrojs/starlight/components";

import { Tabs, TabItem } from "@astrojs/starlight/components";
---

<footer class="flex flex-col">
  <Tabs>
    <TabItem label="Apps">
      <CardGrid>
        <LinkCard
          title="Dashboard"
          href="https://nbadashboard.jyablonski.dev/"
          target={"_blank"}
        />
        <LinkCard
          title="REST API"
          href="https://api.jyablonski.dev/"
          target={"_blank"}
        />
        <LinkCard
          title="Docs"
          href="https://doqs.jyablonski.dev/"
          target={"_blank"}
        />
      </CardGrid>
    </TabItem>
    <TabItem label="Repos">
      <CardGrid>
        <LinkCard
          title="Ingestion"
          href="https://github.com/jyablonski/nba_elt_ingestion"
          target={"_blank"}
        />
        <LinkCard
          title="dbt"
          href="https://github.com/jyablonski/nba_elt_dbt"
          target={"_blank"}
        />
        <LinkCard
          title="REST API"
          href="https://github.com/jyablonski/nba_elt_rest_api"
          target={"_blank"}
        />
      </CardGrid>
    </TabItem>
  </Tabs>
  <div class="meta sl-flex">
    <EditLink {...Astro.props} />
    <LastUpdated {...Astro.props} />
  </div>
  <Pagination {...Astro.props} />
</footer>
<style>
  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-block: 3rem 1.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .meta > :global(p:only-child) {
    margin-inline-start: auto;
  }
</style>
