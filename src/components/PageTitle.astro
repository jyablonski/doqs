---
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/PageTitle.astro";

// Type for custom frontmatter fields
interface EntryData {
  author?: string;
  lastUpdated?: Date | string | boolean;
  tags?: string[];
}

// Access entry from props or locals (Starlight may put it in different places)
const entry =
  (Astro.props as any)?.entry || (Astro.locals as any)?.starlightRoute?.entry;

const data: EntryData | undefined = entry?.data;

const author = data?.author;
const lastUpdated = data?.lastUpdated;
const tags = data?.tags;

// Format the date nicely (lastUpdated can be boolean, Date, or string)
// Use timeZone: "UTC" to prevent date shifting due to local timezone conversion
let formattedDate: string | null = null;
if (lastUpdated instanceof Date) {
  formattedDate = lastUpdated.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
} else if (typeof lastUpdated === "string") {
  formattedDate = new Date(lastUpdated).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
}

// Check if we have any metadata to display
const hasMetadata = author || formattedDate || (tags && tags.length > 0);
---

<Default {...Astro.props} />

{
  hasMetadata && (
    <div class="doc-meta">
      {author && (
        <div class="meta-item">
          <span class="meta-label">Author</span>
          <span class="meta-value">{author}</span>
        </div>
      )}
      {formattedDate && (
        <div class="meta-item">
          <span class="meta-label">Updated</span>
          <span class="meta-value">{formattedDate}</span>
        </div>
      )}
      {tags && tags.length > 0 && (
        <div class="meta-item">
          <span class="meta-label">Tags</span>
          <span class="meta-value">
            {tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </span>
        </div>
      )}
    </div>
  )
}

<style>
  .doc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
    font-size: var(--sl-text-sm);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .meta-label {
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-value {
    color: var(--sl-color-white);
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    background: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    border-radius: 0.25rem;
    font-size: 0.75rem;
  }
</style>
