---
import type { Props } from "@astrojs/starlight/props";
import { getCollection } from "astro:content";

// Get current page info from Starlight props
const currentEntry =
  (Astro.props as any)?.entry || (Astro.locals as any)?.starlightRoute?.entry;

const currentTags: string[] = currentEntry?.data?.tags || [];
const currentId: string = currentEntry?.id || "";

// Pages to exclude from related docs
const excludedPages = ["404", "index"];

// Get all docs from the collection
const allDocs = await getCollection("docs");

// Calculate relevance score based on shared tags
interface ScoredDoc {
  id: string;
  slug: string;
  title: string;
  description?: string;
  tags: string[];
  score: number;
  sharedTags: string[];
}

const scoredDocs: ScoredDoc[] = allDocs
  .filter((doc) => {
    // Exclude current page
    if (doc.id === currentId) return false;
    // Exclude special pages
    const pageName =
      doc.id
        .split("/")
        .pop()
        ?.replace(/\.(md|mdx)$/, "") || "";
    if (excludedPages.includes(pageName)) return false;
    // Exclude drafts
    if (doc.data.draft) return false;
    return true;
  })
  .map((doc) => {
    const docTags: string[] = (doc.data as any).tags || [];
    const sharedTags = currentTags.filter((tag) => docTags.includes(tag));
    return {
      id: doc.id,
      slug: doc.id.replace(/\.(md|mdx)$/, ""),
      title: doc.data.title,
      description: doc.data.description,
      tags: docTags,
      score: sharedTags.length,
      sharedTags,
    };
  })
  .filter((doc) => doc.score > 0) // Only include docs with at least 1 shared tag
  .sort((a, b) => b.score - a.score) // Sort by score descending
  .slice(0, 3); // Take top 3

const hasRelatedDocs = scoredDocs.length > 0 && currentTags.length > 0;
---

{
  hasRelatedDocs && (
    <aside class="related-docs">
      <h2 class="related-heading">Related Pages</h2>
      <div class="related-grid">
        {scoredDocs.map((doc) => (
          <a href={`/${doc.slug}/`} class="related-card">
            <span class="related-title">{doc.title}</span>
            {doc.description && (
              <span class="related-description">{doc.description}</span>
            )}
            <span class="related-tags">
              {doc.sharedTags.map((tag) => (
                <span class="related-tag">{tag}</span>
              ))}
            </span>
          </a>
        ))}
      </div>
    </aside>
  )
}

<style>
  .related-docs {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .related-heading {
    font-size: var(--sl-text-lg);
    font-weight: 600;
    color: var(--sl-color-white);
    margin-bottom: 1rem;
  }

  .related-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    text-decoration: none;
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .related-card:hover {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-gray-5);
  }

  .related-title {
    font-weight: 600;
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
  }

  .related-description {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  .related-tag {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    border-radius: 0.25rem;
    font-size: 0.7rem;
    font-weight: 500;
  }
</style>
